  "hard_floors": [
    "F1:no_oracle",
    "F2:past_14d_live_open",
    "F3:roi_fit_cutline",
    "F4:effort_split_70_30",
    "F5:job_identity_email",
    "F6:truth_and_style",
    "F7:jev_fail_closed",
    "F8:gate_d_exact_text"
  ],
  "llm_backends": {
    "primary": {
      "name": "rig-litellm-gateway",
      "base_url": "http://127.0.0.1:18770/v1",
      "default_model": "rig-auto"
    },
    "zero_api_cost_fallback": {
      "name": "agentic-architectures-codex-shim",
      "base_url": "http://127.0.0.1:8035/v1",
      "default_model": "codex"
    }
